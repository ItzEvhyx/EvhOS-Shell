+
+fn download_files(downloads: &std::path::Path) -> Vec<PathBuf> {
+    let mut files = Vec::new();
+    for dir in download_folders(downloads) {
+        if let Ok(entries) = std::fs::read_dir(dir) {
+            files.extend(entries.flatten().filter_map(|entry| {
+                let path = entry.path();
+                let name = entry.file_name();
+                let name = name.to_string_lossy();
+                if name.starts_with('.') || name.ends_with(".part") || name.ends_with(".crdownload") || !entry.file_type().ok()?.is_file() { return None; }
+                Some(path)
+            }));
+        }
+    }
+    files
+}
+
+/// Follow real folders in Downloads without crossing symlinks or walking hidden trees.
+pub fn download_folders(root: &std::path::Path) -> Vec<PathBuf> {
+    let mut folders = vec![root.to_path_buf()];
+    let mut index = 0;
+    while index < folders.len() && folders.len() < 2048 {
+        if let Ok(entries) = std::fs::read_dir(&folders[index]) {
+            for entry in entries.flatten() {
+                if folders.len() >= 2048 { break; }
+                if !entry.file_name().to_string_lossy().starts_with('.') && entry.file_type().is_ok_and(|t| t.is_dir()) {
+                    folders.push(entry.path());
+                }
+            }
+        }
+        index += 1;
+    }
+    folders
+}
+
+fn activity_order(mut entries: Vec<(u64, PathBuf)>, shared: Vec<(u64, PathBuf)>) -> Vec<PathBuf> {
+    entries.extend(shared);
+    let mut times = std::collections::HashMap::<PathBuf, std::time::SystemTime>::new();
+    for (_, path) in entries {
+        let Ok(meta) = std::fs::metadata(&path) else { continue };
+        if !meta.is_file() { continue; }
+        let Some(name) = path.file_name() else { continue };
+        let name = name.to_string_lossy();
+        if name.starts_with('.') || name.ends_with(".part") || name.ends_with(".crdownload") { continue; }
+        let disk = [meta.created().ok(), meta.modified().ok()].into_iter().flatten()
+            .max().unwrap_or(std::time::UNIX_EPOCH);
+        let time = disk;
+        times.entry(path).and_modify(|old| *old = (*old).max(time)).or_insert(time);
+    }
+    let mut paths: Vec<_> = times.into_iter().collect();
+    paths.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    paths.into_iter().map(|(path, _)| path).collect()
 }
 
 /// Both sources newest first (Ski's wins a tie), each path once.
+#[cfg(test)]
 fn merge(mut all: Vec<(u64, PathBuf)>, shared: Vec<(u64, PathBuf)>) -> Vec<PathBuf> {
     all.extend(shared);
     all.sort_by_key(|e| std::cmp::Reverse(e.0));
